# =============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN PHÒNG TRỌ THÁI NGUYÊN (CHO LOCAL VÀ VERCEL)
# =============================================================================

# 1. Google Gemini AI API Key (Dùng cho Tìm kiếm AI & Chatbot thông minh)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# 2. JWT Secret Key (Dùng để ký mã hóa token đăng nhập người dùng)
JWT_SECRET="your-super-secret-jwt-key-2025"

# 3. PostgreSQL Database Connection URL (Supabase PostgreSQL)
# Ví dụ kết nối Supabase Pooler (khuyên dùng trên Vercel):
# postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/phongtro_tn"

# 4. Supabase Project URL (Dùng cho Supabase Storage lưu trữ hình ảnh phòng trọ)
SUPABASE_URL="https://your-project-ref.supabase.co"

# 5. Supabase Service Role Key (Secret Key cấp quyền backend upload ảnh vào bucket room-images)
# Lấy tại Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# 6. Giới hạn số connection trong Pool (Mặc định 3 trên Vercel Serverless để không làm quá tải DB)
DB_POOL_MAX="3"

# 7. Cổng chạy máy chủ Local (Mặc định 3000 khi chạy dev)
PORT="3000"
