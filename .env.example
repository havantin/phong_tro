# =============================================================================
# GEMINI_API_KEY: Key gọi API Google Gemini cho Tìm kiếm Thông minh & Bot AI
# 👉 Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey (Google AI Studio)
# Bấm "Create API key" -> Chọn project hoặc tạo project mới -> Copy key (bắt đầu bằng AIzaSy...)
# Dán key vào file .env theo cú pháp: GEMINI_API_KEY="AIzaSy..."
# =============================================================================
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server port (default 3000)
PORT="3000"

# JWT_SECRET: Secret key for signing JWT tokens
JWT_SECRET="thai-nguyen-phongtro-secret-key-2025"

# DATABASE_URL: PostgreSQL connection string (or SQLite for local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phongtro_tn"

# SUPABASE_URL: Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://ubvitrnokzanjxeydhxt.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Supabase secret service_role key for backend storage uploads
# (Find in Supabase Dashboard -> Project Settings -> API -> service_role secret key)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVidml0cm5va3phbmp4ZXlkaHh0Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTA2NjY2MCwiZXhwIjoyMTA2NjQyNjYwfQ.5xzio2p97vWvABDWcRTlLMfzuno0ZWxX1ySxCfOC8GY"

